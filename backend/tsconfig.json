{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"types": ["node", "jest", "./src/types.d.ts"],
		"jsx": "react-jsx",
		"isolatedModules": true,
		"baseUrl": ".",
		"paths": {
			"@modules/*": ["src/modules/*"],
			"@shared/*": ["src/shared/*"]
		}
	},
	"include": ["src"],
	"exclude": ["dist"]
}
